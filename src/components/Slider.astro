<!-- Portfolio Slider Section -->
<section id="portfolio" class="py-20 px-4 bg-white">
  <div class="container mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block bg-[#08298E] text-white px-6 py-2 rounded-full text-sm font-semibold mb-4">
        NOS RÉALISATIONS
      </span>
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900">
        Nos travaux électriques
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Découvrez nos réalisations récentes. Chaque projet reflète notre expertise 
        et notre engagement envers la qualité.
      </p>
    </div>

    <!-- Single Slider Container -->
    <div class="relative max-w-5xl mx-auto">
      <div class="slider-wrapper overflow-hidden rounded-2xl shadow-2xl bg-gray-100">
        <div class="slider-track flex transition-transform duration-700 ease-out" id="sliderTrack">
          <!-- Image slides will be populated here -->
        </div>
      </div>

      <!-- Navigation Arrows -->
      <button 
        class="nav-arrow nav-prev absolute left-4 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 p-3 rounded-full shadow-lg transition-all duration-300 hover:scale-110 z-10 opacity-0 pointer-events-none"
        id="prevBtn"
        aria-label="Image précédente"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      
      <button 
        class="nav-arrow nav-next absolute right-4 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 p-3 rounded-full shadow-lg transition-all duration-300 hover:scale-110 z-10 opacity-0 pointer-events-none"
        id="nextBtn"
        aria-label="Image suivante"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <!-- Dots Navigation -->
      <div class="flex justify-center mt-8 space-x-3" id="dotsContainer">
        <!-- Dots will be generated dynamically -->
      </div>

      <!-- Loading State -->
      <div id="loadingState" class="aspect-video flex items-center justify-center text-gray-500">
        <div class="text-center">
          <div class="animate-spin w-8 h-8 border-2 border-[#08298E] border-t-transparent rounded-full mx-auto mb-4"></div>
          <p>Chargement des images...</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Type definitions
  interface GalleryImage {
    src: string;
    alt: string;
    title: string;
    description: string;
  }

  interface SliderElements {
    sliderTrack: HTMLElement | null;
    dotsContainer: HTMLElement | null;
    prevBtn: HTMLButtonElement | null;
    nextBtn: HTMLButtonElement | null;
    loadingState: HTMLElement | null;
  }

  // Gallery configuration
  const galleryImages: GalleryImage[] = [
          {
          src: '/gallery/2.jpg',
           alt: 'Installation électrique résidentielle',
          title: 'Installation Électrique',
          description: 'Installations électriques complètes pour bureaux, villas et appartements'
        },
        {
            src: '/gallery/3.jpg',
            alt: 'Armoire électrique',
            title: 'Armoire Électrique',
            description: 'Équipement et câblage d\'armoires électriques professionnelles'
        },
        {
            src: '/gallery/4.jpg',
            alt: 'Éclairage LED moderne',
            title: 'Éclairage LED',
            description: 'Installation de spots lumineux cachés et éclairage moderne'
        },
        {
          src: '/gallery/1.jpg',
          alt: 'Installation électrique résidentielle',
          title: 'Installation Électrique',
          description: 'Installations électriques complètes pour bureaux, villas et appartements'
        },
    {
      src: '/gallery/5.jpg',
      alt: 'Rénovation électrique',
      title: 'Rénovation Électrique',
      description: 'Rénovation complète d\'installations électriques existantes'
    },
    {
      src: '/gallery/6.jpg',
       alt: 'Rénovation électrique',
      title: 'Rénovation Électrique',
      description: 'Rénovation complète d\'installations électriques existantes'
    },
    {
      src: '/gallery/7.jpg',
              alt: 'Éclairage LED moderne',
      title: 'Éclairage LED',
      description: 'Installation de spots lumineux cachés et éclairage moderne'
    },
    {
      src: '/gallery/8.jpg',
      alt: 'Installation électrique résidentielle',
      title: 'Installation Électrique',
      description: 'Installations électriques complètes pour bureaux, villas et appartements'
    },
    {
      src: '/gallery/10.jpg',
       alt: 'Installation électrique résidentielle',
      title: 'Installation Électrique',
      description: 'Installations électriques complètes pour bureaux, villas et appartements'
    }
    // ... (rest of your gallery images remain the same)
  ];


  // Slider state
  let currentSlide: number = 0;
  let totalSlides: number = 0;
  let autoSlideInterval: number | NodeJS.Timeout | null = null;
  let isInitialized: boolean = false;

  // Get DOM elements with proper typing
  const elements: SliderElements = {
    sliderTrack: document.getElementById('sliderTrack'),
    dotsContainer: document.getElementById('dotsContainer'),
    prevBtn: document.getElementById('prevBtn') as HTMLButtonElement | null,
    nextBtn: document.getElementById('nextBtn') as HTMLButtonElement | null,
    loadingState: document.getElementById('loadingState')
  };

  // Preload images for better performance
  function preloadImages(): Promise<void[]> {
    return Promise.all(
      galleryImages.map((image: GalleryImage) => {
        return new Promise<void>((resolve, reject) => {
          const img = new Image();
          img.onload = () => resolve();
          img.onerror = () => reject(new Error(`Failed to load image: ${image.src}`));
          img.src = image.src;
        });
      })
    );
  }

  // Create slide element
  function createSlide(image: GalleryImage, index: number): string {
    return `
      <div class="slide w-full flex-shrink-0 relative group" data-slide="${index}">
        <img 
          src="${image.src}" 
          alt="${image.alt}"
          class="w-full aspect-video object-cover"
          loading="${index === 0 ? 'eager' : 'lazy'}"
        >
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
            <h3 class="text-2xl font-bold mb-2">${image.title}</h3>
            <p class="text-gray-200 text-lg">${image.description}</p>
          </div>
        </div>
      </div>
    `;
  }

  // Create dot element
  function createDot(index: number): string {
    return `
      <button 
        class="dot w-3 h-3 rounded-full transition-all duration-300 hover:scale-125 ${index === 0 ? 'bg-[#08298E]' : 'bg-gray-300'}"
        data-slide="${index}"
        aria-label="Aller à l'image ${index + 1}"
      ></button>
    `;
  }

  // Initialize slider
  function initSlider(): void {
    if (isInitialized) return;
    
    // Show loading state
    if (elements.loadingState) {
      elements.loadingState.style.display = 'flex';
    }
    
    // Preload images
    preloadImages()
      .then(() => {
        // Hide loading state
        if (elements.loadingState) {
          elements.loadingState.style.display = 'none';
        }
        
        // Generate slides
        totalSlides = galleryImages.length;
        if (elements.sliderTrack) {
          elements.sliderTrack.innerHTML = galleryImages.map(createSlide).join('');
        }
        
        // Generate dots
        if (elements.dotsContainer) {
          elements.dotsContainer.innerHTML = galleryImages.map((_, index) => 
            createDot(index)
          ).join('');
        }
        
        // Show navigation if more than one slide
        if (totalSlides > 1) {
          if (elements.prevBtn) {
            elements.prevBtn.classList.add('opacity-100');
            elements.prevBtn.classList.remove('pointer-events-none');
          }
          if (elements.nextBtn) {
            elements.nextBtn.classList.add('opacity-100');
            elements.nextBtn.classList.remove('pointer-events-none');
          }
          
          // Start auto-slide
          startAutoSlide();
        }
        
        // Add event listeners
        addEventListeners();
        
        isInitialized = true;
      })
      .catch((error: Error) => {
        console.error('Error loading gallery images:', error);
        if (elements.loadingState) {
          elements.loadingState.innerHTML = `
            <div class="text-center text-red-600">
              <p>Erreur lors du chargement des images</p>
              <button onclick="initSlider()" class="mt-4 px-4 py-2 bg-[#08298E] text-white rounded hover:bg-blue-700">
                Réessayer
              </button>
            </div>
          `;
        }
      });
  }

  // Update slider position and dots
  function updateSlider(): void {
    if (elements.sliderTrack) {
      elements.sliderTrack.style.transform = `translateX(-${currentSlide * 100}%)`;
    }
    
    // Update dots
    if (elements.dotsContainer) {
      const dots = elements.dotsContainer.querySelectorAll('.dot');
      dots.forEach((dot, index) => {
        dot.classList.toggle('bg-[#08298E]', index === currentSlide);
        dot.classList.toggle('bg-gray-300', index !== currentSlide);
      });
    }
  }

  // Navigation functions
  function nextSlide(): void {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlider();
    resetAutoSlide();
  }

  function previousSlide(): void {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateSlider();
    resetAutoSlide();
  }

  function goToSlide(index: number): void {
    if (index < 0 || index >= totalSlides) return;
    currentSlide = index;
    updateSlider();
    resetAutoSlide();
  }

  // Auto-slide functionality
  function startAutoSlide(): void {
    if (totalSlides <= 1) return;
    autoSlideInterval = setInterval(nextSlide, 6000);
  }

  function resetAutoSlide(): void {
    if (autoSlideInterval) {
      clearInterval(autoSlideInterval as number);
    }
    startAutoSlide();
  }

  function stopAutoSlide(): void {
    if (autoSlideInterval) {
      clearInterval(autoSlideInterval as number);
    }
  }

  // Event listeners
  function addEventListeners(): void {
    // Navigation buttons
    if (elements.prevBtn) {
      elements.prevBtn.addEventListener('click', previousSlide);
    }
    if (elements.nextBtn) {
      elements.nextBtn.addEventListener('click', nextSlide);
    }
    
    // Dots navigation
    if (elements.dotsContainer) {
      elements.dotsContainer.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        if (target && target.classList.contains('dot')) {
          const slideIndex = parseInt(target.getAttribute('data-slide') || '0');
          if (!isNaN(slideIndex)) {
            goToSlide(slideIndex);
          }
        }
      });
    }
    
    // Hover pause/resume
    const sliderWrapper = document.querySelector('.slider-wrapper');
    if (sliderWrapper) {
      sliderWrapper.addEventListener('mouseenter', stopAutoSlide);
      sliderWrapper.addEventListener('mouseleave', startAutoSlide);
    }
    
    // Touch/swipe support
    let startX = 0;
    let isDown = false;
    
if (sliderWrapper) {
  // Touch start handler
  sliderWrapper.addEventListener('touchstart', (e: Event) => {
    const touchEvent = e as TouchEvent;
    if (touchEvent.touches && touchEvent.touches[0]) {
      startX = touchEvent.touches[0].clientX;
      isDown = true;
    }
  }, { passive: true });
  
  // Touch move handler
  sliderWrapper.addEventListener('touchmove', (e: Event) => {
    if (!isDown) return;
    const touchEvent = e as TouchEvent;
    touchEvent.preventDefault();
  }, { passive: false }); // passive must be false when calling preventDefault()
  
  // Touch end handler
  sliderWrapper.addEventListener('touchend', (e: Event) => {
    if (!isDown) return;
    isDown = false;
    
    const touchEvent = e as TouchEvent;
    if (touchEvent.changedTouches && touchEvent.changedTouches[0]) {
      const endX = touchEvent.changedTouches[0].clientX;
      const deltaX = startX - endX;
      
      if (Math.abs(deltaX) > 50) {
        if (deltaX > 0) {
          nextSlide();
        } else {
          previousSlide();
        }
      }
    }
  }, { passive: true });
}
    
    // Keyboard navigation
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') previousSlide();
      if (e.key === 'ArrowRight') nextSlide();
    });
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', initSlider);
  
  // Intersection Observer for lazy loading
  const portfolioSection = document.getElementById('portfolio');
  if (portfolioSection) {
    const observer = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !isInitialized) {
          initSlider();
        }
      });
    });
    
    observer.observe(portfolioSection);
  }
</script>

<style>
  .slider-wrapper {
    position: relative;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  }
  
  .slider-track {
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .slide {
    min-width: 100%;
  }
  
  .nav-arrow {
    backdrop-filter: blur(10px);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .dot {
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .dot:hover {
    transform: scale(1.25);
  }
  
  /* Smooth image loading */
  img {
    transition: opacity 0.3s ease;
  }
  
  /* Responsive optimizations */
  @media (max-width: 768px) {
    .nav-arrow {
      padding: 0.5rem;
    }
    
    .nav-arrow svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }
  
  /* Prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .slider-track {
      transition: none;
    }
    
    .nav-arrow,
    .dot {
      transition: none;
    }
  }
</style>